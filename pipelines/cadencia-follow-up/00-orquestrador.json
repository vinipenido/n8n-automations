        "filtersUI": {
          "values": [
            {
              "lookupColumn": "numero",
              "lookupValue": "={{ \n(() => {\n  let celular = String($json.body.recipient);\n\n  if (!celular) return null;\n\n  // Remove tudo que não for número\n  let numeros = celular.replace(/\\D/g, '');\n\n  // Remove código do país caso venha junto\n  if (numeros.startsWith('55')) {\n    numeros = numeros.slice(2);\n  }\n\n  // Extrai DDD\n  const ddd = numeros.slice(0, 2);\n  let numero = numeros.slice(2);\n\n  // Se número tiver 8 dígitos (fixo ou celular antigo), adiciona o 9\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  // Se tiver 9 dígitos mas não começar com 9, adiciona\n  if (numero.length === 9 && !numero.startsWith('9')) {\n    numero = '9' + numero.slice(1);\n  }\n\n  // Retorno final\n  return `55${ddd}${numero}`;\n})()\n}}"
            }
          ]
        },
        "options": {}
      },
