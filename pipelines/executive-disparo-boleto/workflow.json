        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ \n(() => {\n  let celular = $('If5').item.json.celular;\n\n  if (!celular) return null;\n\n  // Remove tudo que não for número\n  let numeros = celular.replace(/\\D/g, '');\n\n  // Remove código do país caso venha junto\n  if (numeros.startsWith('55')) {\n    numeros = numeros.slice(2);\n  }\n\n  // Extrai DDD\n  const ddd = numeros.slice(0, 2);\n  let numero = numeros.slice(2);\n\n  // Se número tiver 8 dígitos (fixo ou celular antigo), adiciona o 9\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  // Se tiver 9 dígitos mas não começar com 9, adiciona\n  if (numero.length === 9 && !numero.startsWith('9')) {\n    numero = '9' + numero.slice(1);\n  }\n\n  // Retorno final\n  return `55${ddd}${numero}`;\n})()\n}}"
            },
            {
              "name": "message",
              "value": "=Olá  {{ $json.nome_associado }}, tudo bem? Aqui é a Iara, da Executive Seguros. Estou passando somente pra lembrar o(a) senhor(a) sobre o boleto com vencimento em {{ \n(() => {\n  const d = new Date();\n  d.setDate(d.getDate() + 2);\n  return d.toLocaleDateString('pt-BR');\n})()\n}}. O boleto está disponível em {{ $json.short_link }}\n\nAgradeço pela atenção e desejo um ótimo dia para o(a) senhor(a)."
            }
          ]
        },
        "options": {}
