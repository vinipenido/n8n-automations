    {
      "parameters": {
        "jsCode": "// Padroniza todos os itens e divide em lotes de 500\nconst items = $input.all();\nconst BATCH_SIZE = 500;\n\n// Padroniza e filtra linhas inválidas\nconst rows = items\n  .filter(item => {\n    const cod = String(item.json[\"Código Produto\"] || \"\").trim();\n    const desc = String(item.json[\"Descrição do Produto\"] || \"\").trim();\n    return cod !== \"\" && desc !== \"\";\n  })\n  .map(item => ({\n    codigo_produto: String(item.json[\"Código Produto\"] || \"\").trim(),\n    descricao:      String(item.json[\"Descrição do Produto\"] || \"\").trim(),\n    marca:          String(item.json[\"Marca\"] || \"\").trim(),\n    qtd_estoque:    Number(String(item.json[\"Qtd.Estoque\"] || \"0\").replace(\",\", \".\")),\n    preco_venda:    Number(String(item.json[\"Preço de venda\"] || \"0\").replace(\",\", \".\")),\n    grupo:          String(item.json[\"Grupo\"] || \"\").trim(),\n    sub_grupo:      String(item.json[\"Sub-Grupo\"] || \"\").trim(),\n    tipo:           String(item.json[\"Tipo\"] || \"\").trim(),\n    item:           String(item.json[\"Item\"] || \"\").trim()\n  }));\n\n// Divide em lotes de 500\nconst batches = [];\nfor (let i = 0; i < rows.length; i += BATCH_SIZE) {\n  batches.push({\n    json: {\n      lote: Math.floor(i / BATCH_SIZE) + 1,\n      total_lotes: Math.ceil(rows.length / BATCH_SIZE),\n      total_produtos: rows.length,\n      rows: rows.slice(i, i + BATCH_SIZE)\n    }\n  });\n}\n\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1248,
        64
      ],
      "id": "93af9526-28a1-44d7-b8c7-8cf8247590c3",
